{
  "name": "georamp",
  "displayName": "GeoRamp — GeoTIFF & Raster Viewer",
  "description": "Open, overlay and explore geospatial rasters in VS Code with scientific color ramps.",
  "version": "0.4.0",
  "publisher": "jordanzav",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordan-zav/GeoRamp.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "geotiff",
    "tiff",
    "raster",
    "geophysics",
    "colormap",
    "gis"
  ],
  "activationEvents": [
    "onCustomEditor:georamp.viewer",
    "onCommand:georamp.openPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "georamp.openPreview",
        "title": "GeoRamp: Open GeoTIFF Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "georamp.viewer",
        "displayName": "GeoRamp Raster Viewer",
        "selector": [
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.TIF"
          },
          {
            "filenamePattern": "*.TIFF"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "GeoRamp",
      "properties": {
        "georamp.previewMaxDimension": {
          "type": "number",
          "default": 1400,
          "minimum": 512,
          "maximum": 4096,
          "description": "Maximum width or height of the decoded preview. Larger values use more memory."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "georamp.openPreview",
          "when": "resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .TIF || resourceExtname == .TIFF",
          "group": "navigation@8"
        }
      ]
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.js && node scripts/test-import-manager.js && node scripts/test-import-provider.js && node scripts/test-qgis-features.js",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "check:webview": "node scripts/validate-webview.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "epsg-index": "^2.0.0",
    "geotiff": "^2.1.3",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
