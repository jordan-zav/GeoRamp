{
  "name": "georamp",
  "displayName": "GeoRamp",
  "description": "Interactive GeoTIFF viewer with scientific and geophysical color ramps.",
  "version": "0.2.1",
  "publisher": "jordanzav",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Visualization", "Other"],
  "keywords": ["geotiff", "tiff", "raster", "geophysics", "colormap", "gis"],
  "activationEvents": ["onCustomEditor:georamp.viewer", "onCommand:georamp.openPreview"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "georamp.openPreview",
        "title": "GeoRamp: Open GeoTIFF Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "georamp.viewer",
        "displayName": "GeoRamp Viewer",
        "selector": [
          {"filenamePattern": "*.tif"},
          {"filenamePattern": "*.tiff"},
          {"filenamePattern": "*.TIF"},
          {"filenamePattern": "*.TIFF"}
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "GeoRamp",
      "properties": {
        "georamp.previewMaxDimension": {
          "type": "number",
          "default": 1400,
          "minimum": 512,
          "maximum": 4096,
          "description": "Maximum width or height of the decoded preview. Larger values use more memory."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "georamp.openPreview",
          "when": "resourceExtname == .tif || resourceExtname == .tiff || resourceExtname == .TIF || resourceExtname == .TIFF",
          "group": "navigation@8"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "check:webview": "node scripts/validate-webview.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build",
    "package:vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "geotiff": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
